{
  "name": "AutoBE — Mobile Modpack Tool",
  "short_name": "AutoBE",
  "description": "Merge Minecraft Bedrock behavior and resource packs into one modpack, entirely on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#08050f",
  "theme_color": "#170b2a",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/assets/autobe-app-icon.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/zip": [
          ".mcpack",
          ".mcaddon",
          ".zip"
        ]
      }
    }
  ]
}
