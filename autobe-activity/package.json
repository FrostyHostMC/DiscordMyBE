{
  "name": "autobe-mobile-modpack-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Merge Minecraft Bedrock behavior and resource packs into one installable modpack, entirely on-device.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npx tsx scripts/generateCodebaseArchive.ts && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "generate:codebase": "npx tsx scripts/generateCodebaseArchive.ts",
    "test": "npm run test:merge && npm run test:verify",
    "test:merge": "esbuild scripts/testMerge.ts --bundle --platform=node --format=esm --outfile=scripts/.testMerge.mjs --alias:@=./src --external:jszip --log-level=warning && node scripts/.testMerge.mjs",
    "test:verify": "esbuild scripts/testVerification.ts --bundle --platform=node --format=esm --outfile=scripts/.testVerify.mjs --alias:@=./src --external:jszip --log-level=warning && node scripts/.testVerify.mjs"
  },
  "dependencies": {
    "@aippy/runtime": "^0.4.1",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@zip.js/zip.js": "^2.7.53",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@aippy/vite-plugins": "0.3.0",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}